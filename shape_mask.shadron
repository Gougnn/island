#version 440
#include <variables>
#include <ease>



//.     . 2D SIGNED DISTANCE FIELDS .     .


float sdCircle( vec2 p, float r )
{
    return length(p) - r;
}

float sdBox( in vec2 p, in vec2 b )
{
    vec2 d = abs(p)-b;
    return length(max(d,0.0)) + min(max(d.x,d.y),0.0);
}

float sdRoundedBox( in vec2 p, in vec2 b, in vec4 r )
{
    r.xy = (p.x>0.0)?r.xy : r.zw;
    r.x  = (p.y>0.0)?r.x  : r.y;
    vec2 q = abs(p)-b+r.x;
    return min(max(q.x,q.y),0.0) + length(max(q,0.0)) - r.x;
}

float sdParabola( in vec2 pos, in float k )
{
    pos.x = abs(pos.x);
    float ik = 1.0/k;
    float p = ik*(pos.y - 0.5*ik)/3.0;
    float q = 0.25*ik*ik*pos.x;
    float h = q*q - p*p*p;
    float r = sqrt(abs(h));
    float x = (h>0.0) ? 
        pow(q+r,1.0/3.0) - pow(abs(q-r),1.0/3.0)*sign(r-q) :
        2.0*cos(atan(r,q)/3.0)*sqrt(p);
    return length(pos-vec2(x,k*x*x)) * sign(pos.x-x);
}

float sdBlobbyCross( in vec2 pos, float he )
{
    pos = abs(pos);
    pos = vec2(abs(pos.x-pos.y),1.0-pos.x-pos.y)/sqrt(2.0);

    float p = (he-pos.y-0.25/he)/(6.0*he);
    float q = pos.x/(he*he*16.0);
    float h = q*q - p*p*p;
    
    float x;
    if( h>0.0 ) { float r = sqrt(h); x = pow(q+r,1.0/3.0)-pow(abs(q-r),1.0/3.0)*sign(r-q); }
    else        { float r = sqrt(p); x = 2.0*r*cos(acos(q/(p*r))/3.0); }
    x = min(x,sqrt(2.0)/2.0);
    
    vec2 z = vec2(x,he*(1.0-2.0*x*x)) - pos;
    return length(z) * sign(z.y);
}



//.     . SD OPERATIONS .     .


float opAnnular( float sdf, float r )
{
    return abs(sdf) - r;
}

float opRounded( float sdf, float r )
{
    return sdf - r;
}

float opSmoothUnion( float d1, float d2, float k )
{
    float h = clamp( 0.5 + 0.5*(d2-d1)/k, 0.0, 1.0 );
    return mix( d2, d1, h ) - k*h*(1.0-h);
}

float opSmoothSubtraction( float d1, float d2, float k )
{
    float h = clamp( 0.5 - 0.5*(d2+d1)/k, 0.0, 1.0 );
    return mix( d2, -d1, h ) + k*h*(1.0-h);
}

float opSmoothIntersection( float d1, float d2, float k )
{
    float h = clamp( 0.5 - 0.5*(d2-d1)/k, 0.0, 1.0 );
    return mix( d2, d1, h ) + k*h*(1.0-h);
}



//.     . UV MANIPULATION .     .


vec2 uvCenter( vec2 uv )
{
    return uv * 2.0f - 1.0f;
}



//.     . MATRICES MATH .     .


float matDet(mat2 matrice )
{
    float
        a = matrice[0][0], b = matrice[0][1],
        c = matrice[1][0], d = matrice[1][1];
    
    return a*d - b*c;
}

float matDet( mat3 matrice )
{
    float
        a = matrice[0][0], b = matrice[0][1], c = matrice[0][2],
        d = matrice[1][0], e = matrice[1][1], f = matrice[1][2],
        g = matrice[2][0], h = matrice[2][1], i = matrice[2][2];
        
    return a*e*i + d*h*c + b*f*g - (g*e*c + d*b*i + a*h*f);
}

mat2 matInvert( mat2 matrice )
{
    float
        a = matrice[0][0], b = matrice[0][1],
        c = matrice[1][0], d = matrice[1][1];
    
    return 1.0f/matDet(matrice) * mat2( d, -b, 
                                       -c,  a);
}

mat3 matInvert( mat3 matrice )
{
    float
        a = matrice[0][0], b = matrice[0][1], c = matrice[0][2],
        d = matrice[1][0], e = matrice[1][1], f = matrice[1][2],
        g = matrice[2][0], h = matrice[2][1], i = matrice[2][2], 

        a1 = matDet(mat2(e, f, h, i)), b1 = matDet(mat2(c, b, i, h)), c1 = matDet(mat2(b, c, e, f)),
        d1 = matDet(mat2(f, d, i, g)), e1 = matDet(mat2(a, c, g, i)), f1 = matDet(mat2(c, a, f, d)),
        g1 = matDet(mat2(d, e, g, h)), h1 = matDet(mat2(b, a, h, g)), i1 = matDet(mat2(a, b, d, e));

    return 1.0f/matDet(matrice) * mat3(a1, b1, c1, 
                                       d1, e1, f1, 
                                       g1, h1, i1);
}

vec2 transform( vec2 v, vec2 translate, float scale, float rotate )
{
    mat3 t = mat3(1, 0, translate.x,
                  0, 1, translate.y,
                  0, 0, 1);
    mat3 s = mat3(1/scale, 0, 0,
                  0, 1/scale, 0,
                  0, 0, 1);
    mat3 r = mat3(cos(rotate), sin(rotate), 0,
                  -sin(rotate), cos(rotate), 0,
                  0, 0, 1);
    
    return (vec3(v.xy, 1.0f) * t * s * r).xy;
}

vec2 invertTransform( vec2 v, vec2 translate, float scale, float rotate )
{
    mat3 t = mat3(1, 0, translate.x,
                  0, 1, translate.y,
                  0, 0, 1);
    mat3 s = mat3(1/scale, 0, 0,
                  0, 1/scale, 0,
                  0, 0, 1);
    mat3 r = mat3(cos(rotate), sin(rotate), 0,
                  -sin(rotate), cos(rotate), 0,
                  0, 0, 1);
    
    return (vec3(v.xy, 1.0f) * matInvert(t * s * r)).xy;
}