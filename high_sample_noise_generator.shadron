//         .     . TEST ZONE .     .


template <test>
float forloop( float n )
{
    float p;
    for (float i = 0; i < n; i++)
    {
        p = test(3, 2);
    }
    return p;
}

float mul( float a, float n )
{
    return a*n;
}

template <height_map>
vec3 shape( vec2 uv )
{
    vec4 NOISE = texture(height_map, uv);
    float distort = (NOISE.x);
    vec2 distortedUV = transform(uv, vec2(-0.5f), mix(0.5f, distort,clamp(temp-(uv.y)+0.25, 0, 1)), 0.0f); // CENTER UV
    float layer1 = (sdParabola(distortedUV+vec2(0.0f, -0.4f), -16.0f)) < 0.0f ? 0.333f : 0.0f;
    float layer2 = (sdParabola(distortedUV+vec2(0.0f, -0.45f), -2.1f)) < 0.0f ? 0.333f : 0.0f;
    float layer3 = (sdParabola(distortedUV+vec2(0.0f, -0.5f), -1.0f)) < 0.0f ? 0.333f : 0.0f;
    // float layer4 = (sdParabola(uv+vec2(0.0f, -0.5f), -0.5f)) < 0.0f ? 0.2f : 0.0f;
    // float layer5 = (sdParabola(uv+vec2(0.0f, -0.5f), -0.25f)) < 0.0f ? 0.2f : 0.0f;

    // return vec3();
    return vec3(forloop<mul>(3));
    return vec3(layer1+layer2+layer3);//+layer4+layer5);
} 





image MASK = glsl(shape<NOISE_HIGH_SAMPLE>, ivec2(512));

